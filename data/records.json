  "notes": [
    {
      "id": "N1",
      "visit": "V1",
      "writer": "汪芸",
      "text": "渡口往下到柳栏末端走完，按百米折合各查二十分钟，同一标准捡塑料。前两段共见瓶12个，到了桥下另外见5个。渡口另外称过全队拾的四袋，总8公斤。"
    },
    {
      "id": "N2",
      "visit": "V2",
      "writer": "汪芸",
      "text": "从渡口往下两段都扫过，但到桥上弯后半封着，实际只走到170米。每一百米查二十分钟。桥下另一队搬来半袋，在桥下称重不算桥下捡的。自己这边和对岸合起来称了6公斤。"
    },
    {
      "id": "N3",
      "visit": "V2",
      "writer": "卢兰",
      "text": "本队那两段共见瓶10个，没有按段数。桥下那半袋是同一批。"
    },
    {
      "id": "N4",
      "visit": "V3",
      "writer": "贝周",
      "text": "对岸渡台到120处已查过，二十四分钟，没见瓶。桥对岸走到一半避水退了，没过秤。"
    },
    {
      "id": "N5",
      "visit": "V4",
      "writer": "贝周",
      "text": "对岸渡台查24分钟，一个瓶。桥对岸查28分钟，未见瓶。"
    },
    {
      "id": "N6",
      "visit": "V5",
      "writer": "方岩",
      "text": "石渠没下去。桥下只走一半，没有条件称，袋子在堤顶。"
    },
    {
      "id": "N7",
      "visit": "V2",
      "writer": "汪芸",
      "text": "原第6公斤是左岸自己两段和渡台队各自带来的袋一起上秤，称点在桥下；批号柳17。"
    },
    {
      "id": "N8",
      "visit": "V3",
      "writer": "贝周",
      "text": "渡台交去那半袋也写作柳17，没单称；在桥边水里另看到瓶，没走近，不能确定在哪段。"
    }
  ],
